---
import '@/styles/global.css'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>T-Shirt Stryd | Premium Apparel</title>
  </head>
  <body
    class="bg-transparent text-white font-['Inter'] selection:bg-orange-500/30"
  >
    <div
      class="fixed inset-0 -z-10 bg-[#0a0a0a] bg-[radial-gradient(circle_at_50%_50%,rgba(17,17,17,1)_0%,rgba(0,0,0,1)_100%)]"
    >
    </div>
    <slot />
    <footer class="border-t border-white/10 py-6 text-center text-xs text-white/60">
      <a href="https://rsanjur.com" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 hover:text-white">
        <svg width="18" height="18" viewBox="0 0 512 512" aria-hidden="true" style="flex:none"><rect width="512" height="512" rx="112" fill="#0B1220"/><text x="256" y="340" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="252" font-weight="800" letter-spacing="-8" fill="#FFFFFF">RS</text><rect x="196" y="380" width="120" height="26" rx="13" fill="#22D3EE"/></svg>
        <span>Sitio hecho por <b>rsanjur.com</b></span>
      </a>
      <p class="mt-1 text-white/40">¿Quieres una página así? <a href="https://rsanjur.com/#contacto" target="_blank" rel="noopener" class="hover:text-white">Escríbeme</a></p>
    </footer>
  </body>
</html>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Outfit', sans-serif;
  }
</style>
