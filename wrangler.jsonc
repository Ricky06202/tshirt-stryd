{
  "main": "dist/_worker.js/index.js",
  "name": "tshirt-stryd",
  "compatibility_date": "2026-01-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tshirt-stryd",
      "database_id": "48f82131-79e6-4d64-ae64-ed3da7fbe113",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tshirt-stryd-images",
      "remote": true,
    },
  ],
}